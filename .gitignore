# ──────────────────────────────────────────────────────────────
# ML artifacts — DO NOT commit large binaries
# ──────────────────────────────────────────────────────────────
# Trained weights (xem models/README.md để biết cách tải lại)
*.pt
*.pth
*.onnx
*.engine
*.tflite
models/*
!models/README.md

# Datasets (tải qua Roboflow — xem data/README.md)
data/*
!data/README.md
!data/samples/
data/samples/*
!data/samples/.gitkeep

# Generated outputs (video/ảnh chú giải, radar, voronoi)
outputs/*
!outputs/.gitkeep

# Experiment tracking & dataset downloads
wandb/
runs/
*.zip

# ──────────────────────────────────────────────────────────────
