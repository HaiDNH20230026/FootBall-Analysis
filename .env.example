# ──────────────────────────────────────────────────────────────
# Sao chép file này thành `.env` và điền giá trị thật.
# `.env` đã được .gitignore — KHÔNG commit khóa API lên Git.
# Đọc trong code bằng python-dotenv hoặc os.environ.
# ──────────────────────────────────────────────────────────────

# Roboflow — dùng cho tải dataset và gọi hosted inference API
ROBOFLOW_API_KEY=

# Weights & Biases — theo dõi quá trình huấn luyện
WANDB_API_KEY=

# (Tùy chọn) ID model đã deploy trên Roboflow để gọi qua get_model()
ROBOFLOW_PLAYER_MODEL_ID=
ROBOFLOW_PITCH_MODEL_ID=
